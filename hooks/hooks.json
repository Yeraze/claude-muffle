{
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/display_hook.py"],
            "timeout": 10,
            "statusMessage": "muffling output"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/*.md)",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/write_hook.py"],
            "timeout": 15,
            "statusMessage": "muffling markdown"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.md)",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/write_hook.py"],
            "timeout": 15,
            "statusMessage": "muffling markdown"
          }
        ]
      }
    ]
  }
}
